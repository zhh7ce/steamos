+    pub fn apply_tablet_region_from_config(
+        &mut self,
+        region_config: &niri_config::TabletRegionConfig,
+    ) {
+        use crate::input::{TabletRegion, TabletRegionSource};
+        use smithay::utils::{Point, Rectangle, Size};
+
+        let region = TabletRegion {
+            output: region_config.output.clone(),
+            bounds: Rectangle::new(
+                Point::from((region_config.x, region_config.y)),
+                Size::from((region_config.width, region_config.height)),
+            ),
+            source: TabletRegionSource::Config,
+        };
+
+        // Apply the region to all connected tablets
+        for tablet_data in self.niri.tablets.values_mut() {
+            // Only update if there's no higher-priority region active
+            if tablet_data.region.is_none()
+                || matches!(
+                    tablet_data.region.as_ref().map(|r| r.source),
+                    Some(TabletRegionSource::Config)
+                )
+            {
+                tablet_data.region = Some(region.clone());
+            }
+        }
+    }
+
+    pub fn clear_tablet_regions_from_config(&mut self) {
+        use crate::input::TabletRegionSource;
+
+        // Remove config-sourced regions from all tablets
+        for tablet_data in self.niri.tablets.values_mut() {
+            if matches!(
+                tablet_data.region.as_ref().map(|r| r.source),
+                Some(TabletRegionSource::Config)
+            ) {
+                tablet_data.region = None;
+            }
+        }
+    }
