_module_name="hid-magicmouse-bat"
_module_version="1.0"

post_install() {
    echo ":: Adding ${_module_name} v${_module_version} to DKMS..."
    dkms add "${_module_name}/${_module_version}" 2>/dev/null || true
    
    echo ":: Building ${_module_name} v${_module_version}..."
    dkms build "${_module_name}/${_module_version}" 2>/dev/null || true
    
    echo ":: Installing ${_module_name} v${_module_version}..."
    dkms install "${_module_name}/${_module_version}" 2>/dev/null || true
    
    echo ""
    echo ":: Module installed successfully!"
    echo ":: Please regenerate initramfs and reboot:"
    echo "   sudo mkinitcpio -P"
    echo "   sudo reboot"
}

pre_upgrade() {
    echo ":: Removing old ${_module_name} module before upgrade..."
    dkms remove "${_module_name}/${_module_version}" 2>/dev/null || true
}

post_upgrade() {
    post_install
}

pre_remove() {
    echo ":: Removing ${_module_name} v${_module_version} from DKMS..."
    dkms remove "${_module_name}/${_module_version}" 2>/dev/null || true
}
